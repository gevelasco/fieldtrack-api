NODE_ENV=local
PORT=4001

# Host: 127.0.0.1 con `npm run start:dev`. Dentro de Docker Compose (api): DB_HOST=postgres
DB_HOST=127.0.0.1
# 5434 evita choque si terminalops u otras apps ya ocupan 5432/5433
DB_PORT=5434
DB_USERNAME=fieldtrack-developer
DB_PASSWORD=test1234
DB_DATABASE=fieldtrack-dev
# En cloud (Railway/etc.): DB_SSL=true
# DB_SSL=false

# CORS del FE (producción: https://app.tudominio.com — varias separadas por coma)
ORIGIN=http://localhost:4201

# Genera secretos nuevos en PRD (≥32 chars, distintos). Nunca uses estos de ejemplo.
JWT_SECRET=2f8c7e1a9b4d4e3f8a6c2b7e5d1f9c3a
JWT_REFRESH_SECRET=2f8c7e1a9b4d4e3f8a6c2b7e5d1u8788
SALT_ROUNDS=10

# Alertas 5xx (Slack/Discord incoming webhook). Opcional.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Swagger: en production queda OFF salvo ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false
